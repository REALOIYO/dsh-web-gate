{
  "name": "dsh-web-gate",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness Web UI 加一层带密码的局域网网关：手机浏览器直接访问，不注入任何页面代码。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lan",
    "mobile",
    "remote",
    "proxy",
    "loopback"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
