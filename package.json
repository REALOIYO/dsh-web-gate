{
  "name": "@realoiyo/dsh-web-gate",
  "version": "0.2.0",
  "description": "DeepSeek Harness 的局域网网关：密码认证，同网段浏览器访问，不修改 DSH 页面。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REALOIYO/dsh-web-gate.git"
  },
  "homepage": "https://github.com/REALOIYO/dsh-web-gate#readme",
  "bugs": {
    "url": "https://github.com/REALOIYO/dsh-web-gate/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lan",
    "mobile",
    "remote",
    "proxy",
    "loopback"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
